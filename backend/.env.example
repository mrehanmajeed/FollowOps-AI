# FollowOps AI — backend configuration
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every value below is a name only; no real secret belongs in this file.

# --- Application -----------------------------------------------------------
APP_NAME=FollowOps AI
APP_VERSION=0.3.0
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Operator authentication ------------------------------------------------
# Shared bearer token for the operator console. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend asks for this at sign-in; it is not a provider credential.
OPERATOR_API_KEY=

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase ---------------------------------------------------------------
# SUPABASE_SECRET_KEY is the server-only secret ("service role") key.
# It bypasses RLS and must never reach a browser.
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias for the legacy name.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Zoho Mail: SMTP (outbound follow-up email) -----------------------------
# Use the real Zoho mailbox address and an app-specific password.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_USE_TLS=true

# --- Zoho Mail: IMAP (inbound reply detection) ------------------------------
# The mailbox is opened read-only; FollowOps never modifies or deletes mail.
# IMAP_USER / IMAP_PASSWORD default to the SMTP values when left blank, which
# is correct when one mailbox both sends and receives.
# Regional accounts use imap.zoho.eu / imap.zoho.in / imap.zoho.com.au.
ZOHO_IMAP_ENABLED=true
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USER=
ZOHO_IMAP_PASSWORD=
ZOHO_IMAP_USE_SSL=true
ZOHO_IMAP_MAILBOX=INBOX
ZOHO_IMAP_POLL_INTERVAL_SECONDS=120
ZOHO_IMAP_LOOKBACK_DAYS=14
ZOHO_IMAP_MAX_MESSAGES_PER_POLL=50

# --- CRM --------------------------------------------------------------------
# "simulated" records the proposed update in the audit log and reports itself
# as simulated everywhere. No external CRM adapter is implemented.
CRM_MODE=simulated
